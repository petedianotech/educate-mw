# CEREBRAS_API_KEY: Required for Cerebras API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
CEREBRAS_API_KEY="YOUR_CEREBRAS_API_KEY"

# GEMINI_API_KEY: Required for Gemini Live API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PayChangu Payment API Configuration
VITE_PAYCHANGU_PUBLIC_KEY="YOUR_PUBLIC_KEY"
PAYCHANGU_SECRET_KEY="YOUR_SECRET_KEY"
PAYCHANGU_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME="dor5twyep"
VITE_CLOUDINARY_UPLOAD_PRESET="secondary_school_notes"

