{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "prebuild": "bash scripts/ensure_offline_assets.sh || true; python3 scripts/fix_production_ux.py || true; python3 scripts/patch_emi_grounding.py || true; python3 scripts/fix_share_origin.py || true; python3 scripts/fix_certificates_prod.py || true; python3 scripts/fix_prod_batch.py || true; python3 scripts/fix_pull_to_refresh.py || true; python3 scripts/fix_emi_live_ui.py || true; python3 scripts/fix_emi_live_layout_v2.py || true; python3 scripts/fix_emi_ux_pack.py || true; python3 scripts/fix_vercel_build.py || true",
    "predev": "bash scripts/ensure_offline_assets.sh || true"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^6.2.3",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-legacy": "^6.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "terser": "^5.39.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
