rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'petedianotech@gmail.com' ||
        request.auth.token.email == 'mscepreparation@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Collections ---

    // Users
    match /users/{userId} {
      function isValidUser(data) {
        return data.get('name', '') is string && 
               data.get('email', '') is string;
      }

      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data);
                      
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Materials
    match /materials/{materialId} {
      function isValidMaterial(data) {
        return data.title is string && data.title.size() <= 200 &&
               data.content is string && data.content.size() <= 1000000 &&
               data.type in ['pdf', 'video', 'text']; // Removed authorId check since admin can create it
      }

      allow read: if true;
      allow write: if isAdmin() && isValidId(materialId);
    }

    // Community Flashcards & Quizzes
    match /flashcards/{flashcardId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Certificates section
    match /certificates/{certificateId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // Videos section
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(videoId);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(notificationId);
    }

    // Community Feeds & Discussions
    match /feeds/{feedId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());

      match /replies/{replyId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      }
    }

    // Study Circle WhatsApp-style Group Messages
    match /group_messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // allow adding emoji reactions, edits, pinning
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Community Groups & Circles
    match /groups/{groupId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.creatorId);
    }

    // Group Announcements
    match /group_announcements/{announcementId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());
    }

    // Group Discussions
    match /group_discussions/{discussionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());

      match /responses/{responseId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());
      }
    }

    // Teacher Assignments
    match /group_assignments/{assignmentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.teacherId || isAdmin());
    }

    // Assignment Submissions
    match /assignment_submissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.studentId || isAdmin());
    }

    // Group Events
    match /group_events/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.creatorId || isAdmin());
    }

    // Group Polls
    match /group_polls/{pollId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.creatorId || isAdmin());
    }

    // Group Resources
    match /group_resources/{resourceId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.uploaderId || isAdmin());
    }

    // Group Requests & Approvals
    match /group_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Class Levels
    match /class_levels/{levelId} {
      allow read: if true;
      allow write: if true;
    }

    // Real-time User Presence
    match /user_presence/{presenceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() || isAdmin();
    }

    // AI Feedback
    match /ai_feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
